{
  "module": "GLDrivers",
  "version": "1.0",
  "copyright": "\u00a9 2025 DART Meadow | Radical Deepscale LLC. LEATR.",
  "description": "Ash Edge Language GL Driver definitions. import (GLDrivers) in any .ash script to enable 3D WebGL visual output inside the Ash Tree IDE visualizer panel.",
  "import_keyword": "import (GLDrivers)",
  "runtime_global": "ASH_GL",
  "canvas_target": "#ash-gl-canvas",
  "panel_target": "#visualizer-panel",
  "node_drivers": {
    "ThreeScene": {
      "description": "Initialize a Three.js scene with renderer, default camera, and render loop",
      "ash_syntax": "(ThreeScene):-: { irin(\"canvas:#ash-gl-canvas\") gl.scene gl.camera gl.light gl.render }|';'|",
      "parameters": {
        "background": {
          "type": "hex-color",
          "default": "0x000814",
          "irin_key": "background"
        },
        "antialias": {
          "type": "boolean",
          "default": true,
          "irin_key": "antialias"
        },
        "fov": {
          "type": "number",
          "default": 60,
          "irin_key": "fov"
        },
        "near": {
          "type": "number",
          "default": 0.1,
          "irin_key": "near"
        },
        "far": {
          "type": "number",
          "default": 1000,
          "irin_key": "far"
        }
      },
      "js_api": "new THREE.Scene(); THREE.WebGLRenderer; THREE.PerspectiveCamera",
      "runtime_function": "ASH_GL.ThreeScene",
      "outputs": [
        "scene",
        "renderer",
        "camera"
      ]
    },
    "CameraNode": {
      "description": "Add PerspectiveCamera with OrbitControls to an existing scene",
      "ash_syntax": "(CameraNode):-: { irin(\"fov:60 pos:0,2,8\") gl.camera }|';'|",
      "parameters": {
        "fov": {
          "type": "number",
          "default": 60,
          "irin_key": "fov"
        },
        "pos_x": {
          "type": "number",
          "default": 0,
          "irin_key": "px"
        },
        "pos_y": {
          "type": "number",
          "default": 2,
          "irin_key": "py"
        },
        "pos_z": {
          "type": "number",
          "default": 8,
          "irin_key": "pz"
        },
        "orbit": {
          "type": "boolean",
          "default": true,
          "irin_key": "orbit"
        }
      },
      "js_api": "THREE.PerspectiveCamera; OrbitControls from three/addons",
      "runtime_function": "ASH_GL.CameraNode",
      "outputs": [
        "camera",
        "controls"
      ]
    },
    "LightNode": {
      "description": "Add directional + ambient lights to scene",
      "ash_syntax": "(LightNode):-: { irin(\"ambient:0x223344 dir:0xffffff\") gl.light }|';'|",
      "parameters": {
        "ambient_color": {
          "type": "hex-color",
          "default": "0x223344",
          "irin_key": "ambient"
        },
        "dir_color": {
          "type": "hex-color",
          "default": "0xffffff",
          "irin_key": "dir"
        },
        "dir_intensity": {
          "type": "number",
          "default": 1.4,
          "irin_key": "intensity"
        },
        "dir_x": {
          "type": "number",
          "default": 5,
          "irin_key": "dx"
        },
        "dir_y": {
          "type": "number",
          "default": 10,
          "irin_key": "dy"
        },
        "dir_z": {
          "type": "number",
          "default": 7,
          "irin_key": "dz"
        }
      },
      "js_api": "THREE.AmbientLight; THREE.DirectionalLight",
      "runtime_function": "ASH_GL.LightNode",
      "outputs": [
        "ambientLight",
        "dirLight"
      ]
    },
    "GeometryNode": {
      "description": "Create a geometry primitive (box, sphere, torus, cylinder, plane, icosahedron)",
      "ash_syntax": "(GeometryNode):-: { irin(\"type:torus r:1.2 tube:0.4 segments:64\") gl.geometry }|';'|",
      "parameters": {
        "type": {
          "type": "enum",
          "values": [
            "box",
            "sphere",
            "torus",
            "cylinder",
            "plane",
            "icosahedron",
            "cone"
          ],
          "default": "box",
          "irin_key": "type"
        },
        "r": {
          "type": "number",
          "default": 1,
          "irin_key": "r"
        },
        "tube": {
          "type": "number",
          "default": 0.4,
          "irin_key": "tube"
        },
        "w": {
          "type": "number",
          "default": 1,
          "irin_key": "w"
        },
        "h": {
          "type": "number",
          "default": 1,
          "irin_key": "h"
        },
        "d": {
          "type": "number",
          "default": 1,
          "irin_key": "d"
        },
        "segments": {
          "type": "number",
          "default": 32,
          "irin_key": "seg"
        },
        "wireframe": {
          "type": "boolean",
          "default": false,
          "irin_key": "wire"
        }
      },
      "js_api": "THREE.BoxGeometry; THREE.SphereGeometry; THREE.TorusGeometry; THREE.CylinderGeometry; THREE.PlaneGeometry; THREE.IcosahedronGeometry; THREE.ConeGeometry",
      "runtime_function": "ASH_GL.GeometryNode",
      "outputs": [
        "geometry"
      ]
    },
    "MaterialNode": {
      "description": "Create a PBR standard or phong material with color, emissive, metalness, roughness",
      "ash_syntax": "(MaterialNode):-: { irin(\"color:0x00ffcc emissive:0x003322 metalness:0.6 roughness:0.3\") gl.material }|';'|",
      "parameters": {
        "type": {
          "type": "enum",
          "values": [
            "standard",
            "phong",
            "basic",
            "wireframe"
          ],
          "default": "standard",
          "irin_key": "type"
        },
        "color": {
          "type": "hex-color",
          "default": "0x00ffcc",
          "irin_key": "color"
        },
        "emissive": {
          "type": "hex-color",
          "default": "0x003322",
          "irin_key": "emissive"
        },
        "emissive_intensity": {
          "type": "number",
          "default": 0.4,
          "irin_key": "emint"
        },
        "metalness": {
          "type": "number",
          "default": 0.6,
          "irin_key": "metalness"
        },
        "roughness": {
          "type": "number",
          "default": 0.3,
          "irin_key": "roughness"
        },
        "opacity": {
          "type": "number",
          "default": 1.0,
          "irin_key": "opacity"
        },
        "wireframe": {
          "type": "boolean",
          "default": false,
          "irin_key": "wire"
        }
      },
      "js_api": "THREE.MeshStandardMaterial; THREE.MeshPhongMaterial; THREE.MeshBasicMaterial",
      "runtime_function": "ASH_GL.MaterialNode",
      "outputs": [
        "material"
      ]
    },
    "MeshNode": {
      "description": "Combine geometry + material into a mesh and add to scene",
      "ash_syntax": "(MeshNode):-: { irin(\"geometry:GeometryNode material:MaterialNode\") gl.mesh }|';'|",
      "parameters": {
        "pos_x": {
          "type": "number",
          "default": 0,
          "irin_key": "px"
        },
        "pos_y": {
          "type": "number",
          "default": 0,
          "irin_key": "py"
        },
        "pos_z": {
          "type": "number",
          "default": 0,
          "irin_key": "pz"
        },
        "rot_x": {
          "type": "number",
          "default": 0,
          "irin_key": "rx"
        },
        "rot_y": {
          "type": "number",
          "default": 0,
          "irin_key": "ry"
        },
        "rot_z": {
          "type": "number",
          "default": 0,
          "irin_key": "rz"
        },
        "scale": {
          "type": "number",
          "default": 1,
          "irin_key": "sc"
        },
        "castShadow": {
          "type": "boolean",
          "default": true,
          "irin_key": "shadow"
        },
        "receiveShadow": {
          "type": "boolean",
          "default": true,
          "irin_key": "rshadow"
        }
      },
      "js_api": "new THREE.Mesh(geometry, material); scene.add(mesh)",
      "runtime_function": "ASH_GL.MeshNode",
      "outputs": [
        "mesh"
      ]
    },
    "AnimateNode": {
      "description": "Attach a per-frame animation to a named mesh \u2014 rotate, oscillate, orbit",
      "ash_syntax": "(AnimateNode):-: { irin(\"target:mesh rx:0.008 ry:0.012\") gl.animate }|';'|",
      "parameters": {
        "target": {
          "type": "string",
          "default": "mesh",
          "irin_key": "target"
        },
        "rx": {
          "type": "number",
          "default": 0,
          "irin_key": "rx"
        },
        "ry": {
          "type": "number",
          "default": 0.01,
          "irin_key": "ry"
        },
        "rz": {
          "type": "number",
          "default": 0,
          "irin_key": "rz"
        },
        "osc_y": {
          "type": "number",
          "default": 0,
          "irin_key": "osc"
        },
        "osc_amp": {
          "type": "number",
          "default": 0.5,
          "irin_key": "amp"
        },
        "osc_spd": {
          "type": "number",
          "default": 1.0,
          "irin_key": "spd"
        }
      },
      "js_api": "requestAnimationFrame loop; mesh.rotation.x += rx; Math.sin(t)*amp",
      "runtime_function": "ASH_GL.AnimateNode",
      "outputs": [
        "animHandle"
      ]
    },
    "ShaderNode": {
      "description": "Create a custom GLSL shader material with vertex/fragment source",
      "ash_syntax": "(ShaderNode):-: { irin(\"preset:glow color:0x00ffcc\") gl.shader }|';'|",
      "parameters": {
        "preset": {
          "type": "enum",
          "values": [
            "glow",
            "pulse",
            "wave",
            "plasma",
            "refract"
          ],
          "default": "glow",
          "irin_key": "preset"
        },
        "color": {
          "type": "hex-color",
          "default": "0x00ffcc",
          "irin_key": "color"
        }
      },
      "js_api": "THREE.ShaderMaterial with built-in GLSL presets",
      "runtime_function": "ASH_GL.ShaderNode",
      "outputs": [
        "shaderMaterial"
      ]
    },
    "GLBLoader": {
      "description": "Load a .glb or .gltf 3D model from URL",
      "ash_syntax": "(GLBLoader):-: { irin(\"url:/models/autumn.glb scale:1 center:true\") gl.load }|';'|",
      "parameters": {
        "url": {
          "type": "string",
          "default": "/models/autumn.glb",
          "irin_key": "url"
        },
        "scale": {
          "type": "number",
          "default": 1,
          "irin_key": "scale"
        },
        "center": {
          "type": "boolean",
          "default": true,
          "irin_key": "center"
        }
      },
      "js_api": "GLTFLoader from three/addons; scene.add(gltf.scene)",
      "runtime_function": "ASH_GL.GLBLoader",
      "outputs": [
        "model"
      ]
    },
    "UIOverlayNode": {
      "description": "Draw a 2D HUD overlay on the canvas \u2014 labels, stats, progress bars",
      "ash_syntax": "(UIOverlayNode):-: { irin(\"label:LEATR Runtime fps:true stats:true\") gl.ui }|';'|",
      "parameters": {
        "label": {
          "type": "string",
          "default": "LEATR Runtime",
          "irin_key": "label"
        },
        "fps": {
          "type": "boolean",
          "default": true,
          "irin_key": "fps"
        },
        "stats": {
          "type": "boolean",
          "default": true,
          "irin_key": "stats"
        }
      },
      "js_api": "CSS2DRenderer or canvas overlay div",
      "runtime_function": "ASH_GL.UIOverlayNode",
      "outputs": [
        "overlay"
      ]
    },
    "ParticleNode": {
      "description": "Create a GPU particle system (point cloud) with motion",
      "ash_syntax": "(ParticleNode):-: { irin(\"count:2000 color:0x00ffcc spread:8 speed:0.3\") gl.mesh }|';'|",
      "parameters": {
        "count": {
          "type": "number",
          "default": 2000,
          "irin_key": "count"
        },
        "color": {
          "type": "hex-color",
          "default": "0x00ffcc",
          "irin_key": "color"
        },
        "spread": {
          "type": "number",
          "default": 8,
          "irin_key": "spread"
        },
        "speed": {
          "type": "number",
          "default": 0.3,
          "irin_key": "speed"
        },
        "size": {
          "type": "number",
          "default": 0.06,
          "irin_key": "size"
        }
      },
      "js_api": "THREE.BufferGeometry + THREE.Points + Float32Array",
      "runtime_function": "ASH_GL.ParticleNode",
      "outputs": [
        "particles"
      ]
    }
  },
  "gl_keyword_map": {
    "gl.scene": "ThreeScene",
    "gl.camera": "CameraNode",
    "gl.light": "LightNode",
    "gl.geometry": "GeometryNode",
    "gl.material": "MaterialNode",
    "gl.mesh": "MeshNode",
    "gl.animate": "AnimateNode",
    "gl.shader": "ShaderNode",
    "gl.load": "GLBLoader",
    "gl.ui": "UIOverlayNode",
    "gl.render": "ThreeScene.startRenderLoop"
  },
  "irin_parser_note": "irin strings inside GL nodes are parsed as key:value pairs separated by spaces. Example: irin(\"type:torus r:1.2 tube:0.4 color:0x00ffcc\") \u2192 {type:'torus', r:1.2, tube:0.4, color:0x00ffcc}",
  "dependency": "Three.js r128+ loaded via CDN in ashtreeide.html",
  "canvas_injection": "ASH_GL auto-injects a <canvas id='ash-gl-canvas'> into #visualizer-panel on first use"
}