{
  "tokens": [
    { "type": "comment",          "regex": "\\/\\/.*" },
    { "type": "node-block-start", "regex": "\\([a-zA-Z0-9_]+\\):-:\\{" },
    { "type": "node-block-end",   "regex": "\\}\\[\\';\\'\\|" },
    { "type": "declaration",      "regex": "\\b(with|var|Var|Input|when|where|and|or|not|for|else|is|if|end|import|return|place)\\b" },
    { "type": "keyword",          "regex": "\\b(thenplace|irin|irout)\\b" },
    { "type": "function-def",     "regex": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b" },
    { "type": "string",           "regex": "\"[^\"]*\"" },
    { "type": "number",           "regex": "\\b\\d+(\\.\\d+)?\\b" },
    { "type": "operator",         "regex": "[=+\\-*\\/()]" },
    { "type": "delimiter",        "regex": "[:(),;]" },
    { "type": "whitespace",       "regex": "\\s+" },
    { "type": "error",            "regex": "." }
  ],
  "parser_rules": {
    "node_block": {
      "start_token": "node-block-start",
      "end_token":   "node-block-end"
    }
  }
}
