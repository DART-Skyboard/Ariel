{
  "language": "Ash Edge Language",
  "version": "2.0",
  "copyright": "\u00a9 2025 DART Meadow | Radical Deepscale LLC. LEATR.",
  "tokens": [
    {
      "type": "comment",
      "regex": "\\/\\/.*"
    },
    {
      "type": "node-block-start",
      "regex": "\\([A-Za-z0-9_]+\\):-:\\s*\\{"
    },
    {
      "type": "node-block-end",
      "regex": "\\}\\|';'\\|"
    },
    {
      "type": "node-block-end-chain",
      "regex": "\\}:{4,}"
    },
    {
      "type": "block-open",
      "regex": "\\{"
    },
    {
      "type": "block-close",
      "regex": "\\}"
    },
    {
      "type": "outer-tag",
      "regex": "\\{\\{[^}]+\\}\\}"
    },
    {
      "type": "inner-tag",
      "regex": "\\[\\[[^\\]]+\\]\\]"
    },
    {
      "type": "poly-tag",
      "regex": "\\[poly:[^\\]]+\\]"
    },
    {
      "type": "net-tag",
      "regex": "\\[net:[^\\]]+\\]"
    },
    {
      "type": "import-stmt",
      "regex": "\\bimport\\s+\\([A-Za-z0-9_]+\\)"
    },
    {
      "type": "keyword",
      "regex": "\\b(irin|irout|thenplace|Research|Report)\\b"
    },
    {
      "type": "declaration",
      "regex": "\\b(with|var|Var|Input|when|where|and|or|not|for|else|is|if|end|import|return|place|placeto)\\b"
    },
    {
      "type": "natural-tool",
      "regex": "\\b(Maze|Puzzle|Envelope|Hammer|Stick|Knife|Scissors)\\b"
    },
    {
      "type": "pipe-sep",
      "regex": "\\|';'\\|"
    },
    {
      "type": "chain-sep",
      "regex": ":{2,}"
    },
    {
      "type": "operator",
      "regex": "[=+\\-*\\/^]|==|!=|<=|>="
    },
    {
      "type": "node-ref",
      "regex": "\\([A-Z][A-Za-z0-9_]*\\)"
    },
    {
      "type": "var-ref",
      "regex": "\\([a-z][A-Za-z0-9_]*\\)"
    },
    {
      "type": "gl-keyword",
      "regex": "\\b(gl\\.scene|gl\\.mesh|gl\\.shader|gl\\.render|gl\\.camera|gl\\.light|gl\\.geometry|gl\\.material|gl\\.texture|gl\\.load|gl\\.export|gl\\.animate)\\b"
    },
    {
      "type": "gl-node",
      "regex": "\\b(ThreeScene|GLBLoader|USDZExport|ShaderNode|MeshNode|CameraNode|LightNode|GeometryNode|MaterialNode)\\b"
    },
    {
      "type": "string",
      "regex": "\"[^\"]*\""
    },
    {
      "type": "number",
      "regex": "\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "type": "function-def",
      "regex": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    },
    {
      "type": "delimiter",
      "regex": "[:,;()\\[\\]]"
    },
    {
      "type": "whitespace",
      "regex": "\\s+"
    },
    {
      "type": "error",
      "regex": "."
    }
  ],
  "parser_rules": {
    "node_block": {
      "start_token": "node-block-start",
      "end_tokens": [
        "node-block-end",
        "node-block-end-chain"
      ],
      "sub_block_open": "block-open",
      "sub_block_close": "block-close"
    },
    "tag_annotation": {
      "tokens": [
        "outer-tag",
        "inner-tag",
        "poly-tag",
        "net-tag"
      ]
    },
    "pipe_separator": "pipe-sep",
    "chain_separator": "chain-sep"
  },
  "syntax_patterns": {
    "node_block": "(NodeName):-:{ ... }|';'|",
    "node_block_chain": "(NodeName):-:{ ... }::::",
    "sub_block": "{ ... }",
    "outer_tag": "{{label:value}}",
    "inner_tag": "[[label:value]]",
    "poly_tag": "[poly:label]",
    "net_tag": "[net:label]",
    "irin": "irin (\"string\" (varRef))",
    "irout": "irout (\"string\" (varRef))",
    "thenplace_node": "thenplace (Target) with (Source)+(s)",
    "thenplace_var": "thenplace var (s) with var (c)",
    "thenplace_expr": "thenplace ((Node)+(1)) == var (g) where (g) = ((...)-1)",
    "place_var": "place var (i) with (NodeRef) { when ... }",
    "place_node": "place (NodeName) with Research: (s) { when ... }",
    "when_clause": "when (Node) = (expr)",
    "where_clause": "where (VarRef) = (expr)",
    "research_block": "Research: (i) * ((NodeA) + (NodeB))|';'|Report: (NodeA) + (NodeB) = (NodeC) * (NodeB)",
    "placeto": "irout (\"Result: \"placeto (NodeRef) + (NodeRef))",
    "placeto_eq": "irout (\"Result: \"placeto (VarRef) == (i))",
    "var_decl": "var (shortname) // Description",
    "Var_decl": "Var (shortname) = Type // Description",
    "import": "import (SentienceJournal)",
    "chain_end": "}::::",
    "pipe_end": "}|';'|"
  },
  "webgl_api_bindings": {
    "description": "Ash node wrappers for 3D/WebGL/Three.js/GLB/USDZ APIs",
    "gl_keyword_tokens": [
      "gl.scene",
      "gl.mesh",
      "gl.shader",
      "gl.render",
      "gl.camera",
      "gl.light",
      "gl.geometry",
      "gl.material",
      "gl.texture",
      "gl.load",
      "gl.export",
      "gl.animate"
    ],
    "node_wrappers": {
      "ThreeScene": "Wraps THREE.Scene + renderer + render loop",
      "GLBLoader": "Wraps THREE.GLTFLoader for .glb/.gltf import",
      "USDZExport": "Wraps USDZExporter for .usdz export",
      "ShaderNode": "Wraps THREE.ShaderMaterial / GLSL custom shaders",
      "MeshNode": "Wraps THREE.Mesh with geometry + material",
      "CameraNode": "Wraps THREE.PerspectiveCamera + OrbitControls",
      "LightNode": "Wraps THREE.DirectionalLight + AmbientLight",
      "GeometryNode": "Wraps THREE.BufferGeometry primitives",
      "MaterialNode": "Wraps THREE.MeshStandardMaterial PBR params"
    }
  }
}