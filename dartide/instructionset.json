{
  "ast_node_mappings": {
    "NodeBlock": {
      "runtime_function": "executeNodeBlock",
      "argument_source": "node"
    },
    "KeywordStatement": {
      "runtime_function": "executeKeywordStatement",
      "argument_source": "node"
    },
    "VarDeclaration": {
      "runtime_function": "executeVarDeclaration",
      "argument_source": "node"
    },
    "FunctionCall": {
      "runtime_function": "executeLegacyFunction",
      "argument_source": "node"
    }
  },
  "keyword_functions": {
    "irin":      "runtime_irin",
    "irout":     "runtime_irout",
    "thenplace": "runtime_thenplace"
  },
  "declaration_passthrough": ["with","var","Var","Input","when","where","and","or","not","for","else","is","if","end","import","return","place"]
}
