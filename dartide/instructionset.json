{
  "ast_node_mappings": {
    "NodeBlock": {
      "runtime_function": "executeNodeBlock",
      "argument_source": "node"
    },
    "KeywordStatement": {
      "runtime_function": "executeKeywordStatement",
      "argument_source": "node"
    },
    "VarDeclaration": {
      "runtime_function": "executeVarDeclaration",
      "argument_source": "node"
    },
    "PlaceStatement": {
      "runtime_function": "executePlaceStatement",
      "argument_source": "node"
    },
    "WhenClause": {
      "runtime_function": "executeWhenClause",
      "argument_source": "node"
    },
    "WhereClause": {
      "runtime_function": "executeWhereClause",
      "argument_source": "node"
    },
    "ResearchBlock": {
      "runtime_function": "executeResearchBlock",
      "argument_source": "node"
    },
    "ReportStatement": {
      "runtime_function": "executeReportStatement",
      "argument_source": "node"
    },
    "ImportStatement": {
      "runtime_function": "executeImport",
      "argument_source": "node"
    },
    "TagAnnotation": {
      "runtime_function": "executeTagAnnotation",
      "argument_source": "node"
    },
    "NaturalToolCall": {
      "runtime_function": "executeNaturalTool",
      "argument_source": "node"
    },
    "GLNodeCall": {
      "runtime_function": "executeGLNode",
      "argument_source": "node"
    },
    "FunctionCall": {
      "runtime_function": "executeLegacyFunction",
      "argument_source": "node"
    }
  },
  "keyword_functions": {
    "irin": "runtime_irin",
    "irout": "runtime_irout",
    "thenplace": "runtime_thenplace",
    "place": "runtime_place",
    "placeto": "runtime_placeto",
    "Research": "runtime_research",
    "Report": "runtime_report"
  },
  "declaration_passthrough": [
    "with",
    "var",
    "Var",
    "Input",
    "when",
    "where",
    "and",
    "or",
    "not",
    "for",
    "else",
    "is",
    "if",
    "end",
    "import",
    "return",
    "place",
    "placeto"
  ],
  "natural_tools_order": [
    {
      "n": "01",
      "name": "Maze",
      "group": "TOOL"
    },
    {
      "n": "02",
      "name": "Puzzle",
      "group": "TOOL"
    },
    {
      "n": "03",
      "name": "Envelope",
      "group": "TOOL"
    },
    {
      "n": "04",
      "name": "Hammer",
      "group": "TOOL"
    },
    {
      "n": "05",
      "name": "Stick",
      "group": "TOOL"
    },
    {
      "n": "06",
      "name": "Knife",
      "group": "TOOL"
    },
    {
      "n": "07",
      "name": "Scissors",
      "group": "TOOL"
    }
  ],
  "gl_node_bindings": {
    "ThreeScene": {
      "js_api": "new THREE.Scene(); renderer setup; render loop",
      "runtime_function": "runtime_gl_ThreeScene"
    },
    "GLBLoader": {
      "js_api": "new GLTFLoader().load(url)",
      "runtime_function": "runtime_gl_GLBLoader"
    },
    "USDZExport": {
      "js_api": "USDZExporter().parse(scene)",
      "runtime_function": "runtime_gl_USDZExport"
    },
    "ShaderNode": {
      "js_api": "new THREE.ShaderMaterial({vert,frag})",
      "runtime_function": "runtime_gl_ShaderNode"
    },
    "MeshNode": {
      "js_api": "new THREE.Mesh(geometry, material)",
      "runtime_function": "runtime_gl_MeshNode"
    },
    "CameraNode": {
      "js_api": "new THREE.PerspectiveCamera + OrbitControls",
      "runtime_function": "runtime_gl_CameraNode"
    },
    "LightNode": {
      "js_api": "THREE.DirectionalLight + AmbientLight",
      "runtime_function": "runtime_gl_LightNode"
    },
    "GeometryNode": {
      "js_api": "THREE.BoxGeometry/SphereGeometry/BufferGeometry",
      "runtime_function": "runtime_gl_GeometryNode"
    },
    "MaterialNode": {
      "js_api": "new THREE.MeshStandardMaterial({...})",
      "runtime_function": "runtime_gl_MaterialNode"
    }
  },
  "block_delimiters": {
    "node_block_open": "(NodeName):-:{",
    "node_block_end_pipe": "}|';'|",
    "node_block_end_chain": "}::::",
    "sub_block_open": "{",
    "sub_block_close": "}"
  },
  "tag_system": {
    "outer_tag": {
      "delimiters": [
        "{{",
        "}}"
      ],
      "scope": "environment isolation"
    },
    "inner_tag": {
      "delimiters": [
        "[[",
        "]]"
      ],
      "scope": "script identity / owner"
    },
    "poly_tag": {
      "delimiters": [
        "[poly:",
        "]}"
      ],
      "scope": "math/physics container"
    },
    "net_tag": {
      "delimiters": [
        "[net:",
        "]}"
      ],
      "scope": "network layer reference"
    }
  }
}